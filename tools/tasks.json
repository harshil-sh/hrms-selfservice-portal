{
  "version": 1,
  "project": {
    "name": "hrms-selfservice-portal",
    "displayName": "HRMS Self-Service Portal",
    "repository": "https://github.com/harshil-sh/hrms-selfservice-portal.git",
    "runnerMode": "sequential-first-incomplete",
    "taskCompletionRule": "Task is completed only when relevant automated tests pass and tasks.json is updated in the same commit."
  },
  "executionPolicy": {
    "readBeforeEachTask": [
      "README.md",
      "AGENTS.md",
      "docs/architecture.md",
      "docs/development-standards.md",
      "docs/testing-strategy.md",
      "docs/api-scope.md",
      "docs/TASKS.md",
      "tools/tasks.json"
    ],
    "allowedStatuses": [
      "pending",
      "in_progress",
      "blocked",
      "completed"
    ],
    "completeOnlyIfTestsPass": true,
    "updateTasksJsonAfterEachTask": true,
    "includeTasksJsonInCommit": true,
    "pushTasksJsonToRemote": true,
    "singleTaskPerRun": true,
    "stopAfterFirstIncompleteTask": true
  },
